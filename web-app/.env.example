# Keycloak SSO — корпоративний Keycloak Viyar, той самий shared-клієнт `qr`,
# що й в ai-agents-ws. Обов'язкові змінні: KEYCLOAK_CLIENT_SECRET, SESSION_SECRET.
KEYCLOAK_CLIENT_ID=qr
KEYCLOAK_CLIENT_SECRET=***
KEYCLOAK_DISCOVERY_URL=https://auth-dev.viyar.tech/auth/realms/ViyarLocal/.well-known/openid-configuration

# Публічна адреса сервісу
REDIRECT_URI=https://slabcutplanner.viyar.tech/api/auth/callback
APP_URL=https://slabcutplanner.viyar.tech/

POSTGRES_PASSWORD=slabcut
SESSION_SECRET=change-me-in-prod
